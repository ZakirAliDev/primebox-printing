ADMIN_PASSWORD=primebox-admin

# MySQL — prefer discrete vars on Hostinger (password is encoded safely in code).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=u821685055_primebox_admin
# DB_PASSWORD=
# DB_NAME=u821685055_primebox
#
# Or a single URL (local/Vercel/Railway):
# DATABASE_URL="mysql://primebox:primebox@127.0.0.1:3306/primebox"
DATABASE_URL=

# Vercel Blob — required for image uploads on Vercel
# Create under Project → Storage → Blob, then:
#   npx vercel env pull
# BLOB_READ_WRITE_TOKEN=
