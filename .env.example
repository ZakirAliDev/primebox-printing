ADMIN_PASSWORD=primebox-admin

# Hostinger MySQL (preferred — discrete vars, password encoded safely in code)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Or a single URL for local Docker MySQL:
# DATABASE_URL="mysql://primebox:primebox@127.0.0.1:3306/primebox"

# Optional. Production default is ../persistent-uploads (survives Hostinger redeploy).
# UPLOADS_DIR=/absolute/path/to/persistent-uploads
